# ─── 谛听云社区版配置 ───

# 服务端口
PORT=8080

# 数据目录（容器内挂载点，通常无需修改）
DATA_DIR=/data

# Chat / LLM（清洗、问答）
# 可指向 OpenAI、DeepSeek、阿里云百炼、本地 vLLM 等任何兼容端点
CHAT_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-your-key-here

# Whisper 语音转写
# 可指向 OpenAI、自建服务或其他兼容端点
# OpenAI 官方：whisper-1；自建 whisper.cpp：tiny/base/small/medium/large
WHISPER_BASE_URL=https://api.openai.com/v1
WHISPER_MODEL=whisper-1

# Embedding 向量化
# 可指向 OpenAI、自建服务（bge-m3 / text-embedding-3-small 等）
EMBED_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small

# 清洗 / 问答模型
LLM_MODEL=gpt-4o-mini
